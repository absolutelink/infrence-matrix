# Inference Matrix — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; docker compose reads it.

# --- Admin / PostgreSQL ---------------------------------------------------
# Required in production (compose runs FASTAPI_ENV=production): a real,
# non-default password. Local `scripts/dev.sh` in local-processes mode
# targets an already-running Postgres and does not need this.
POSTGRES_PASSWORD=change-me

# Local-processes dev (no docker) points these at localhost; the compose
# stack overrides them to the service names.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inference_matrix

# --- Redis --------------------------------------------------------------
# Local-processes dev default below; compose overrides to redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Mock provider (seeded by scripts/dev.sh) ---------------------------
# These match scripts/dev.sh defaults; override only to change the
# seeded machine uid / model alias / registration token.
MOCK_MACHINE_UID=mock-machine-1
MOCK_MODEL_ALIAS=mock-model
MOCK_REGISTRATION_TOKEN=mock-registration-token
